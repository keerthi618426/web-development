<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sweet Crumbs Bakery</title>

    <link rel="stylesheet" href="second.css">

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body>

    <!-- Navigation Bar -->
    <header>
        <nav class="navbar">
            <h1 class="logo">🍰 Sweet Crumbs</h1>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#menu">Our Menu</a></li>
                <li><a href="#custom">Custom Cakes</a></li>
                <li><a href="#offers">Offers</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Home Section -->
    <section class="hero" id="home">
        <div class="hero-content">
            <p class="subtitle">FRESHLY BAKED WITH LOVE</p>

            <h2>Life Is Sweeter<br>With A Little Cake!</h2>

            <p>
                Delicious cakes, delightful pastries, and homemade cookies
                made fresh every day to bring happiness to your celebrations.
            </p>

            <a href="#menu" class="btn">Explore Our Menu</a>
            <a href="#custom" class="btn btn-outline">Order Custom Cake</a>
        </div>
    </section>

    <!-- About Section -->
    <section class="about">
        <div class="about-image">
            <img
                src="https://images.unsplash.com/photo-1488477181946-6428a0291777?auto=format&fit=crop&w=900&q=80"
                alt="Fresh bakery dessert">
        </div>

        <div class="about-content">
            <p class="subtitle">WELCOME TO OUR BAKERY</p>

            <h2>Made With Love,<br>Served With Happiness</h2>

            <p>
                At Sweet Crumbs, we believe every special moment deserves
                something sweet. Our bakers prepare delicious treats using
                quality ingredients, creative designs, and lots of love.
            </p>

            <p>
                From birthday cakes to everyday cookies, we make every
                bite memorable.
            </p>

            <a href="#contact" class="btn">Visit Our Store</a>
        </div>
    </section>

    <!-- Menu Section -->
    <section class="menu section" id="menu">
        <div class="section-heading">
            <p class="subtitle">OUR DELICIOUS COLLECTION</p>
            <h2>Explore Our Sweet Menu</h2>

            <p>Freshly baked treats for every mood and occasion.</p>
        </div>

        <div class="product-container">

            <!-- Cake 1 -->
            <div class="product-card">
                <img
                    src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=700&q=80"
                    alt="Chocolate birthday cake">

                <div class="product-info">
                    <h3>Chocolate Cake</h3>
                    <p>Rich chocolate layers with creamy frosting.</p>
                    <div class="price">₹650 <span>/ 500 g</span></div>
                    <a href="#contact" class="order-btn">Order Now</a>
                </div>
            </div>

            <!-- Cake 2 -->
            <div class="product-card">
                <img
                    src="https://images.unsplash.com/photo-1563729784474-d77dbb933a9e?auto=format&fit=crop&w=700&q=80"
                    alt="Strawberry cake">

                <div class="product-info">
                    <h3>Strawberry Cake</h3>
                    <p>Soft vanilla sponge with strawberry cream.</p>
                    <div class="price">₹750 <span>/ 500 g</span></div>
                    <a href="#contact" class="order-btn">Order Now</a>
                </div>
            </div>

            <!-- Pastry -->
            <div class="product-card">
                <img
                    src="https://images.unsplash.com/photo-1483695028939-5bb13f8648b0?auto=format&fit=crop&w=700&q=80"
                    alt="Freshly baked pastry">

                <div class="product-info">
                    <h3>Chocolate Pastry</h3>
                    <p>Soft pastry filled with delicious chocolate cream.</p>
                    <div class="price">₹100 <span>/ piece</span></div>
                    <a href="#contact" class="order-btn">Order Now</a>
                </div>
            </div>

            <!-- Cupcakes -->
            <div class="product-card">
                <img
                    src="https://images.unsplash.com/photo-1426869884541-df7117556757?auto=format&fit=crop&w=700&q=80"
                    alt="Colorful cupcakes">

                <div class="product-info">
                    <h3>Vanilla Cupcakes</h3>
                    <p>Fluffy cupcakes topped with sweet buttercream.</p>
                    <div class="price">₹80 <span>/ piece</span></div>
                    <a href="#contact" class="order-btn">Order Now</a>
                </div>
            </div>

            <!-- Cookies -->
            <div class="product-card">
                <img
                    src="https://images.unsplash.com/photo-1499636136210-6f4ee915583e?auto=format&fit=crop&w=700&q=80"
                    alt="Chocolate chip cookies">

                <div class="product-info">
                    <h3>Chocolate Cookies</h3>
                    <p>Crunchy cookies with rich chocolate chips.</p>
                    <div class="price">₹180 <span>/ box</span></div>
                    <a href="#contact" class="order-btn">Order Now</a>
                </div>
            </div>

            <!-- Donuts -->
            <div class="product-card">
                <img
                    src="https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=700&q=80"
                    alt="Colorful donuts">

                <div class="product-info">
                    <h3>Glazed Donuts</h3>
                    <p>Soft, fluffy donuts with a sweet glaze.</p>
                    <div class="price">₹90 <span>/ piece</span></div>
                    <a href="#contact" class="order-btn">Order Now</a>
                </div>
            </div>

        </div>
    </section>

    <!-- Custom Cakes Section -->
    <section class="custom-section" id="custom">
        <div class="custom-content">
            <p class="subtitle">YOUR DREAM CAKE, OUR CREATION</p>

            <h2>Make Your Celebration Special!</h2>

            <p>
                Birthday cakes, wedding cakes, anniversary cakes, and
                personalized designs made just for you.
            </p>

            <ul>
                <li>🎂 Personalized cake designs</li>
                <li>💖 Fresh and quality ingredients</li>
                <li>🎉 Perfect for every celebration</li>
                <li>✨ Choose your favorite flavor and design</li>
            </ul>

            <a href="#contact" class="btn">Customize Your Cake</a>
        </div>

        <div class="custom-image">
            <img
                src="https://images.unsplash.com/photo-1535254973040-607b474cb50d?auto=format&fit=crop&w=900&q=80"
                alt="Beautiful custom celebration cake">
        </div>
    </section>

    <!-- Gallery Section -->
    <section class="gallery section">
        <div class="section-heading">
            <p class="subtitle">A FEAST FOR YOUR EYES</p>
            <h2>Our Sweet Gallery</h2>
            <p>Take a look at some of our delicious creations.</p>
        </div>

        <div class="gallery-container">
            <img
                src="https://images.unsplash.com/photo-1557925923-cd4648e211a0?auto=format&fit=crop&w=700&q=80"
                alt="Bakery cake">

            <img
                src="https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=700&q=80"
                alt="Freshly baked bread">

            <img
                src="https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=700&q=80"
                alt="Fresh bakery pastries">

            <img
                src="https://images.unsplash.com/photo-1550617931-e17a7b70dce2?auto=format&fit=crop&w=700&q=80"
                alt="Fresh cupcakes">
        </div>
    </section>

    <!-- Seasonal Offers -->
    <section class="offers section" id="offers">
        <div class="offer-box">
            <p class="subtitle">SWEET DEALS JUST FOR YOU</p>

            <h2>Seasonal Special Offers!</h2>

            <p>
                Celebrate the season with our delicious bakery treats
                and exclusive offers.
            </p>

            <div class="offer-cards">
                <div class="offer-card">
                    <h3>🎂 Birthday Special</h3>
                    <p>Get 10% OFF on selected birthday cakes.</p>
                </div>

                <div class="offer-card">
                    <h3>🍪 Cookie Combo</h3>
                    <p>Buy 2 cookie boxes and get 1 mini cookie pack free.</p>
                </div>

                <div class="offer-card">
                    <h3>🧁 Cupcake Treat</h3>
                    <p>Enjoy a special price on boxes of 6 cupcakes.</p>
                </div>
            </div>

            <p class="offer-note">
                *Offers are sample promotions. Check availability at the store.
            </p>
        </div>
    </section>

    <!-- Customer Testimonials -->
    <section class="testimonials section">
        <div class="section-heading">
            <p class="subtitle">HAPPY CUSTOMERS</p>
            <h2>Sweet Words From Our Customers</h2>
        </div>

        <div class="testimonial-container">

            <div class="testimonial-card">
                <div class="stars">★★★★★</div>
                <p>
                    "The chocolate cake was absolutely delicious!
                    Everyone loved it at my birthday party."
                </p>
                <h3>Priya S.</h3>
            </div>

            <div class="testimonial-card">
                <div class="stars">★★★★★</div>
                <p>
                    "Beautiful cake designs, fresh ingredients,
                    and amazing taste. Highly recommended!"
                </p>
                <h3>Rahul K.</h3>
            </div>

            <div class="testimonial-card">
                <div class="stars">★★★★★</div>
                <p>
                    "Their cookies and pastries are wonderful.
                    This is my favorite place for sweet treats."
                </p>
                <h3>Ananya R.</h3>
            </div>

        </div>
    </section>

    <!-- Contact and Reservation Section -->
    <section class="contact section" id="contact">
        <div class="section-heading">
            <p class="subtitle">WE WOULD LOVE TO HEAR FROM YOU</p>
            <h2>Visit Our Bakery</h2>
            <p>Place an order or send us your custom cake requirements.</p>
        </div>

        <div class="contact-container">

            <div class="contact-info">
                <h3>Contact Information</h3>

                <p>📍 <strong>Address:</strong><br>
                    Main Road, Vijayawada, Andhra Pradesh, India
                </p>

                <p>📞 <strong>Phone:</strong><br>
                    +91 98765 43210
                </p>

                <p>✉️ <strong>Email:</strong><br>
                    sweetcrumbs@example.com
                </p>

                <h3>Opening Hours</h3>

                <p>Monday – Saturday: 9:00 AM – 9:00 PM</p>
                <p>Sunday: 10:00 AM – 8:00 PM</p>
            </div>

            <form class="reservation-form" action="#" method="post">

                <h3>Place Your Order</h3>

                <label for="name">Your Name</label>
                <input type="text" id="name" name="name"
                       placeholder="Enter your name" required>

                <label for="email">Email Address</label>
                <input type="email" id="email" name="email"
                       placeholder="Enter your email" required>

                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone"
                       placeholder="Enter your phone number" required>

                <label for="product">Select Product</label>
                <select id="product" name="product" required>
                    <option value="">Choose a product</option>
                    <option>Chocolate Cake</option>
                    <option>Strawberry Cake</option>
                    <option>Chocolate Pastry</option>
                    <option>Vanilla Cupcakes</option>
                    <option>Chocolate Cookies</option>
                    <option>Custom Cake</option>
                </select>

                <label for="date">Required Date</label>
                <input type="date" id="date" name="date" required>

                <label for="message">Special Requirements</label>
                <textarea id="message" name="message"
                          rows="4"
                          placeholder="Cake flavor, size, design, message..."></textarea>

                <button type="submit" class="btn">Submit Order Request</button>

                <p class="form-note">
                    This demo form does not send orders without a connected backend.
                </p>

            </form>

        </div>
    </section>

    <!-- Footer -->
    <footer>
        <h2>🍰 Sweet Crumbs Bakery</h2>

        <p>Every bite tells a sweet story.</p>

        <div class="footer-links">
            <a href="#home">Home</a>
            <a href="#menu">Menu</a>
            <a href="#custom">Custom Cakes</a>
            <a href="#contact">Contact</a>
        </div>

        <p class="copyright">
            © 2026 Sweet Crumbs Bakery. All rights reserved.
        </p>
    </footer>

</body>
</html>
/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    color: #49332e;
    background-color: #fffaf6;
    line-height: 1.7;
}

h1, h2, h3 {
    font-family: 'Playfair Display', serif;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
}

.section {
    padding: 80px 8%;
}

/* Navigation Bar */
header {
    background-color: #fffaf6;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 10px rgba(80, 40, 30, 0.08);
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 8%;
    gap: 20px;
}

.logo {
    color: #a83f55;
    font-size: 27px;
    white-space: nowrap;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 25px;
    flex-wrap: wrap;
}

.nav-links a {
    color: #49332e;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.3s;
}

.nav-links a:hover {
    color: #c84c65;
}

/* Buttons */
.btn {
    display: inline-block;
    padding: 12px 25px;
    background-color: #b74660;
    color: white;
    border-radius: 30px;
    border: 2px solid #b74660;
    font-size: 14px;
    font-weight: 500;
    transition: 0.3s;
    cursor: pointer;
}

.btn:hover {
    background-color: #8e2e45;
    border-color: #8e2e45;
    transform: translateY(-3px);
}

.btn-outline {
    background-color: transparent;
    color: #a83f55;
    margin-left: 8px;
}

.btn-outline:hover {
    background-color: #b74660;
    color: white;
}

/* Hero Section */
.hero {
    min-height: 600px;
    display: flex;
    align-items: center;
    padding: 80px 8%;
    background:
        linear-gradient(
            90deg,
            rgba(35, 20, 16, 0.78),
            rgba(35, 20, 16, 0.12)
        ),
        url("https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=1800&q=90");

    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 650px;
    color: white;
    animation: fadeIn 1.2s ease;
}

.subtitle {
    color: #c84c65;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 3px;
    margin-bottom: 15px;
}

.hero .subtitle {
    color: #ffd6df;
}

.hero h2 {
    font-size: clamp(38px, 5vw, 65px);
    line-height: 1.2;
    margin-bottom: 20px;
}

.hero-content > p:not(.subtitle) {
    max-width: 520px;
    margin-bottom: 30px;
}

/* About Section */
.about {
    padding: 90px 8%;
    display: flex;
    align-items: center;
    gap: 60px;
}

.about-image,
.about-content {
    flex: 1;
}

.about-image img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    border-radius: 15px;
    box-shadow: 15px 15px 0 #f2d6d5;
}

.about-content h2 {
    font-size: 38px;
    line-height: 1.3;
    margin-bottom: 20px;
}

.about-content p {
    margin-bottom: 20px;
}

/* Section Headings */
.section-heading {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 45px;
}

.section-heading h2 {
    font-size: 38px;
    margin-bottom: 12px;
}

/* Product Menu */
.menu {
    background-color: #fff0f0;
}

.product-container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
}

.product-card {
    background-color: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(90, 45, 35, 0.08);
    transition: transform 0.3s, box-shadow 0.3s;
}

.product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 25px rgba(90, 45, 35, 0.15);
}

.product-card img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    transition: transform 0.5s;
}

.product-card:hover img {
    transform: scale(1.04);
}

.product-info {
    padding: 22px;
}

.product-info h3 {
    font-size: 23px;
    margin-bottom: 8px;
}

.product-info p {
    color: #786660;
    font-size: 14px;
    min-height: 48px;
}

.price {
    color: #b74660;
    font-size: 23px;
    font-weight: 600;
    margin: 15px 0;
}

.price span {
    color: #786660;
    font-size: 13px;
    font-weight: 400;
}

.order-btn {
    display: inline-block;
    padding: 9px 20px;
    color: #b74660;
    border: 1px solid #b74660;
    border-radius: 25px;
    font-size: 13px;
    transition: 0.3s;
}

.order-btn:hover {
    background-color: #b74660;
    color: white;
}

/* Custom Cake Section */
.custom-section {
    padding: 90px 8%;
    display: flex;
    align-items: center;
    gap: 60px;
}

.custom-content,
.custom-image {
    flex: 1;
}

.custom-content h2 {
    font-size: 40px;
    line-height: 1.3;
    margin-bottom: 20px;
}

.custom-content p {
    margin-bottom: 20px;
}

.custom-content ul {
    list-style: none;
    margin-bottom: 25px;
}

.custom-content li {
    margin-bottom: 10px;
}

.custom-image img {
    width: 100%;
    height: 450px;
    object-fit: cover;
    border-radius: 15px;
}

/* Gallery */
.gallery {
    background-color: #fff0f0;
}

.gallery-container {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.gallery-container img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 12px;
    transition: transform 0.4s, box-shadow 0.4s;
}

.gallery-container img:hover {
    transform: scale(1.04);
    box-shadow: 0 8px 20px rgba(80, 40, 30, 0.2);
}

/* Seasonal Offers */
.offers {
    background:
        linear-gradient(rgba(80, 30, 40, 0.84), rgba(80, 30, 40, 0.84)),
        url("https://images.unsplash.com/photo-1488477181946-6428a0291777?auto=format&fit=crop&w=1600&q=80");

    background-size: cover;
    background-position: center;
    color: white;
}

.offer-box {
    max-width: 1100px;
    margin: auto;
    text-align: center;
}

.offers .subtitle {
    color: #ffd0dc;
}

.offer-box > h2 {
    font-size: 40px;
    margin-bottom: 15px;
}

.offer-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin-top: 40px;
}

.offer-card {
    padding: 28px 20px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    transition: 0.3s;
}

.offer-card:hover {
    background-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-5px);
}

.offer-card h3 {
    font-size: 22px;
    margin-bottom: 12px;
}

.offer-note {
    margin-top: 25px;
    font-size: 12px;
}

/* Testimonials */
.testimonial-container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
}

.testimonial-card {
    padding: 30px;
    background-color: white;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(80, 40, 30, 0.08);
    text-align: center;
    transition: transform 0.3s;
}

.testimonial-card:hover {
    transform: translateY(-5px);
}

.stars {
    color: #e7a735;
    font-size: 22px;
    margin-bottom: 15px;
}

.testimonial-card p {
    font-style: italic;
    margin-bottom: 20px;
}

.testimonial-card h3 {
    color: #b74660;
}

/* Contact Section */
.contact {
    background-color: #fff0f0;
}

.contact-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 45px;
    max-width: 1100px;
    margin: auto;
}

.contact-info,
.reservation-form {
    background-color: white;
    padding: 32px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(80, 40, 30, 0.07);
}

.contact-info h3,
.reservation-form h3 {
    font-size: 25px;
    margin-bottom: 20px;
}

.contact-info p {
    margin-bottom: 20px;
    overflow-wrap: anywhere;
}

.reservation-form {
    display: flex;
    flex-direction: column;
}

.reservation-form label {
    margin: 10px 0 5px;
    font-size: 14px;
    font-weight: 500;
}

.reservation-form input,
.reservation-form select,
.reservation-form textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #e5cccc;
    border-radius: 7px;
    background-color: #fffaf8;
    font-family: inherit;
    font-size: 14px;
    outline: none;
}

.reservation-form input:focus,
.reservation-form select:focus,
.reservation-form textarea:focus {
    border-color: #b74660;
    box-shadow: 0 0 0 2px rgba(183, 70, 96, 0.1);
}

.reservation-form textarea {
    resize: vertical;
}

.reservation-form button {
    margin-top: 20px;
    font-family: inherit;
}

.form-note {
    margin-top: 12px;
    font-size: 12px;
    color: #786660;
}

/* Footer */
footer {
    background-color: #392522;
    color: white;
    text-align: center;
    padding: 40px 8% 20px;
}

footer h2 {
    color: #ffd0dc;
    margin-bottom: 10px;
    font-size: 30px;
}

.footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    margin: 25px 0;
}

.footer-links a {
    color: white;
    transition: color 0.3s;
}

.footer-links a:hover {
    color: #ffb7ca;
}

.copyright {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 20px;
    font-size: 13px;
}

/* Animation */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Tablet Responsive Design */
@media (max-width: 1000px) {
    .navbar {
        flex-direction: column;
    }

    .nav-links {
        justify-content: center;
        gap: 15px;
    }

    .product-container {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery-container {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about,
    .custom-section {
        gap: 35px;
    }
}

/* Mobile Responsive Design */
@media (max-width: 650px) {
    .section {
        padding: 55px 6%;
    }

    .navbar {
        padding: 15px 5%;
    }

    .logo {
        font-size: 24px;
    }

    .nav-links {
        gap: 10px 15px;
    }

    .nav-links a {
        font-size: 12px;
    }

    .hero {
        min-height: 520px;
        padding: 60px 6%;
        background-position: center;
    }

    .hero h2 {
        font-size: 40px;
    }

    .hero .btn {
        margin: 5px 0;
    }

    .about,
    .custom-section {
        padding: 55px 6%;
        flex-direction: column;
    }

    .about-image img,
    .custom-image img {
        height: 300px;
    }

    .about-content h2,
    .custom-content h2,
    .section-heading h2,
    .offer-box > h2 {
        font-size: 30px;
    }

    .product-container,
    .gallery-container,
    .offer-cards,
    .testimonial-container,
    .contact-container {
        grid-template-columns: 1fr;
    }

    .product-card img {
        height: 250px;
    }

    .gallery-container img {
        height: 250px;
    }

    .contact-info,
    .reservation-form {
        padding: 22px;
    }

    .footer-links {
        gap: 15px;
    }
}
